{
  "name": "be",
  "version": "1.0.0",
  "description": "Hoisted backend API",
  "main": "index.js",
  "scripts": {
    "dev": "node --no-node-snapshot --watch index.js",
    "start": "node --no-node-snapshot index.js",
    "test:db": "node src/utils/testConnection.js",
    "test": "node --no-node-snapshot node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --no-node-snapshot node_modules/jest/bin/jest.js --runInBand --watch",
    "check:services": "node --no-node-snapshot scripts/check-services.js",
    "storage": "node scripts/storage.js",
    "ai:eval": "node scripts/ai-eval.js",
    "load-test": "node scripts/load-test.js",
    "test:report": "node scripts/test-report.js",
    "db:export-schema": "node scripts/db-tools.js export-schema",
    "db:setup": "node scripts/db-tools.js setup",
    "db:backup": "node scripts/db-tools.js backup",
    "db:restore": "node scripts/db-tools.js restore",
    "db:recompute-stats": "node database/recompute_course_stats.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@google/genai": "^1.52.0",
    "@node-rs/bcrypt": "^1.10.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "isolated-vm": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.22.4",
    "nodemailer": "^8.0.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/setup/global-setup.js",
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 15000
  }
}
