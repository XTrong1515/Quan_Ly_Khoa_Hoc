DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=course_mng

PORT=3001
FE_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=change-me-in-production-use-32plus-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-use-32plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cổng thanh toán đang dùng: zalopay (mặc định) | vnpay. Cổng được chọn chưa cấu hình → dùng cổng còn lại;
# không cổng nào cấu hình → dev mock (redirect thẳng về /payment/result, chỉ ngoài production)
PAYMENT_PROVIDER=zalopay

# ZaloPay sandbox — app demo CÔNG KHAI của ZaloPay (app_id 2554), dùng được ngay để thử.
# Production: xin app_id/key1/key2 riêng từ ZaloPay và đổi ZALOPAY_ENDPOINT=https://openapi.zalopay.vn/v2
ZALOPAY_APP_ID=2554
ZALOPAY_KEY1=sdngKKJmqEMzvh5QQcdD2A9XBSKUNaYn
ZALOPAY_KEY2=trMrHtvjo6myautxDUiAcYsVtaeQ8nhf
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2
ZALOPAY_REDIRECT_URL=http://localhost:5173/payment/result
# URL công khai để ZaloPay gọi khi thu tiền xong (localhost không nhận được). `npm run tunnel` tự mở
# Cloudflare Quick Tunnel và ghi biến này (rồi khởi động lại backend), dạng:
# https://<tên>.trycloudflare.com/api/orders/zalopay-callback . Bỏ trống: xác nhận qua trang kết quả (API query).
ZALOPAY_CALLBACK_URL=

# VNPay sandbox — đăng ký tại https://sandbox.vnpayment.vn/devreg/
# Để trống → dev mock mode (redirect thẳng về /payment/result mà không cần VNPay)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# Email (quên mật khẩu) — Gmail App Password
MAIL_FROM=
GMAIL_APP_PASSWORD=

# Test — DB riêng cho `npm test` (mặc định: <DB_NAME>_test). Bị TRUNCATE mỗi lần chạy test.
# DB_NAME_TEST=course_mng_test

# ── Object storage S3-compatible (video/PDF private) ──────────────
# Dev: MinIO local (npm run storage). Deploy: Cloudflare R2 / AWS S3 — chỉ cần đổi các biến này.
#   R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto, S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=hoisted-media
# Thư mục dữ liệu MinIO (dev)
MINIO_DATA_DIR=./.minio-data

# ── Chấm bài code ─────────────────────────────────────────────────
# Mặc định: sandbox isolated-vm chạy trong BE (không cần cấu hình).
# Tùy chọn: runner từ xa Judge0 — RapidAPI (trả phí theo lượt) hoặc tự host http://localhost:2358
JUDGE0_URL=
JUDGE0_KEY=

# ── Gemini (trợ lý AI) — https://aistudio.google.com/apikey ───────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Model dự phòng khi model chính quá tải / hết quota (theo thứ tự)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash
# Giới hạn thời gian (ms): tổng / chờ chữ đầu tiên mỗi lần thử; model lỗi bị bỏ qua LLM_COOLDOWN_MS
LLM_TIMEOUT_MS=60000
LLM_FIRST_TOKEN_TIMEOUT_MS=15000
LLM_COOLDOWN_MS=60000
# Giới hạn tần suất / user: chat (mỗi giờ), AI sinh quiz (mỗi 10 phút), chạy code (mỗi phút)
AI_CHAT_RATE_LIMIT=30
AI_GENERATE_RATE_LIMIT=10
CODE_RUN_RATE_LIMIT=20
# Xác thực: đăng nhập SAI (15 phút, theo IP+email), đăng ký (giờ), quên/đặt lại mật khẩu, refresh (15 phút)
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=10
AUTH_RESET_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=60
# Hash mật khẩu: để trống = native @node-rs/bcrypt; 'bcryptjs' = bản JavaScript
PASSWORD_HASHER=
# Bộ chấm code: isolated-vm (mặc định) | judge0 (cần JUDGE0_URL)
CODE_RUNNER=isolated-vm

# % hoa hồng nền tảng giữ lại trên mỗi khóa học bán được
PLATFORM_COMMISSION=30

# % phí cổng thanh toán (ZaloPay/VNPay) trừ khỏi giá bán TRƯỚC khi chia hoa hồng — điền theo hợp đồng với cổng.
# Chỉ áp cho đơn trả qua cổng (admin xác nhận chuyển khoản / khóa 0đ = 0). Chụp vào đơn lúc thanh toán.
# Ví dụ 2 → khóa 500.000đ: phí 10.000đ, còn 490.000đ chia 70/30 → giảng viên 343.000đ
PAYMENT_FEE_PERCENT=0

# ── Video HLS mã hóa AES-128 (ffmpeg-static, xử lý nền sau khi upload) ──
# Khóa bọc khóa video trong DB: 64 ký tự hex — tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bắt buộc khi NODE_ENV=production; dev để trống thì suy ra từ JWT_ACCESS_SECRET. Đổi khóa = mọi video phải mã hóa lại.
HLS_MASTER_KEY=
# false = không tự mã hóa (test); FFMPEG_PATH để trống = dùng ffmpeg-static; giới hạn thời gian mỗi video (ms)
HLS_AUTO=true
FFMPEG_PATH=
HLS_TIMEOUT_MS=1800000

# Số reverse proxy (Nginx / load balancer) đứng trước API — để rate limit theo IP thấy IP thật của client. 0 = chạy trực tiếp.
TRUST_PROXY=0
